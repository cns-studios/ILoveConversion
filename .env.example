POSTGRES_PASSWORD=
ENCRYPTION_MASTER_KEY=

POSTGRES_USER=ilc
POSTGRES_DB=ilc

NGINX_PORT=8080
API_PORT=3015

MAX_FILE_SIZE=524288000
NGINX_MAX_BODY_SIZE=510m

RATE_LIMIT_PER_HOUR=600
FLAG_THRESHOLD=5000
REDIS_POOL_SIZE=10

CLEANUP_INTERVAL_MINUTES=5
FILE_RETENTION_HOURS=1

WORKER_CONCURRENCY=4
TMPFS_SIZE=1g
API_TMPFS_SIZE=1g

TIMEOUT_IMAGE_CONVERT=120
TIMEOUT_IMAGE_COMPRESS=120
TIMEOUT_IMAGE_REMOVE_BG=180
TIMEOUT_PDF_COMPRESS=300
TIMEOUT_AUDIO_CONVERT=300
TIMEOUT_AUDIO_COMPRESS=300
TIMEOUT_VIDEO_COMPRESS=1800

RETRY_IMAGE=2
RETRY_PDF=2
RETRY_AUDIO=2
RETRY_VIDEO=1

LOG_RETENTION_DAYS=7
DOCKER_CONTAINERS_DIR=/var/lib/docker/containers
