POSTGRES_PASSWORD=
ENCRYPTION_MASTER_KEY=
# Key rotation: give the new key an id, keep the former ones as id:hex pairs.
# Jobs created before rotation carry key_id 1, which is ENCRYPTION_MASTER_KEY until you rotate.
ENCRYPTION_KEY_ID=
ENCRYPTION_OLD_KEYS=

POSTGRES_USER=ilc
POSTGRES_DB=ilc

PORT=5823
API_PORT=3015

MAX_FILE_SIZE=524288000

RATE_LIMIT_PER_HOUR=600
FLAG_THRESHOLD=5000

# Peers whose X-Forwarded-For / CLIENT_IP_HEADER are believed (CIDRs, comma separated).
# Empty trusts nothing and uses the TCP peer address.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=

CLEANUP_INTERVAL_MINUTES=5
FILE_RETENTION_HOURS=1

WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=60
DRAIN_TIMEOUT_SECONDS=120
TMPFS_SIZE=1g

TIMEOUT_IMAGE_CONVERT=120
TIMEOUT_IMAGE_COMPRESS=120
TIMEOUT_IMAGE_REMOVE_BG=180
TIMEOUT_PDF_COMPRESS=300
TIMEOUT_AUDIO_CONVERT=300
TIMEOUT_AUDIO_COMPRESS=300
TIMEOUT_VIDEO_COMPRESS=1800

RETRY_IMAGE=2
RETRY_PDF=2
RETRY_AUDIO=2
RETRY_VIDEO=1

LOG_RETENTION_DAYS=7
DOCKER_CONTAINERS_DIR=/var/lib/docker/containers
